+fi
+
 # Start gnome keyring components if the daemon is active
 # -> check if $XDG_RUNTIME_DIR/keyring exists
 if [ -d "$XDG_RUNTIME_DIR/keyring" ]; then
@@ -104,7 +109,7 @@ fi
 
 # Run cosmic-session
 if [ -z "${DBUS_SESSION_BUS_ADDRESS}" ]; then
