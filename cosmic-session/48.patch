diff --git a/data/start-cosmic b/data/start-cosmic
index f723d5e..d0ca899 100755
--- a/data/start-cosmic
+++ b/data/start-cosmic
@@ -55,6 +55,11 @@ if [ -z "$QT_QPA_PLATFORMTHEME" ]; then
     done
 fi
 
+SSH_AGENT=""
+if [ -x /usr/bin/ssh-agent ]; then
