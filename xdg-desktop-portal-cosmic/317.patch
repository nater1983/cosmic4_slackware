 use crate::{PortalResponse, Session};
 use std::{
     collections::HashMap,
-    env,
     os::{fd::OwnedFd, unix::net::UnixStream},
 };
 use zbus::zvariant;
@@ -88,17 +87,17 @@ impl RemoteDesktop {
         session_handle: zvariant::ObjectPath<'_>,
         app_id: String,
         options: HashMap<String, zvariant::OwnedValue>,
