 1 file changed, 114 insertions(+)

diff --git a/src/libei.rs b/src/libei.rs
index 1d8050284..16f410ee8 100644
--- a/src/libei.rs
+++ b/src/libei.rs
@@ -3,8 +3,12 @@ use std::os::unix::net::UnixStream;
 use reis::eis;
